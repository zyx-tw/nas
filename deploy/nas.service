[Unit]
Description=NAS web drive and share links
After=network-online.target
Wants=network-online.target

[Service]
User=nas
Group=nas
EnvironmentFile=/etc/nas/env
WorkingDirectory=/opt/nas
ExecStart=/usr/local/bin/bun /opt/nas/build/server.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/nas

[Install]
WantedBy=multi-user.target
